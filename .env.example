# 复制为 .env 后按需修改，docker-compose 会自动读取
# ---------------- 数据库 ----------------
MYSQL_ROOT_PASSWORD=please_change_me_root
DB_PASSWORD=please_change_me_app

# ---------------- 安全 ----------------
# 必须是16位字符，用于加密数据库中保存的SSH密码/私钥，务必修改为随机值！
OPS_AES_SECRET=Ch4ng3ThisKey!!!

# ---------------- 告警邮件通知（可选） ----------------
MAIL_HOST=smtp.exmail.qq.com
MAIL_PORT=465
MAIL_USERNAME=ops-alert@yourcompany.com
MAIL_PASSWORD=your_smtp_auth_code
MAIL_FROM=ops-alert@yourcompany.com
ALERT_MAIL_TO=admin@yourcompany.com,noc@yourcompany.com

# ---------------- 告警Webhook通知（可选，企业微信群机器人示例） ----------------
ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
